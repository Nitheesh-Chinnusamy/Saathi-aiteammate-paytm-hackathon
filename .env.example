# Saathi runs fully in MOCK MODE with no keys. Fill these to switch integrations to live.
SARVAM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# inprocess (default) | http  -> mcp_client goes over POST /mcp
MCP_TRANSPORT=inprocess
MCP_BASE_URL=http://127.0.0.1:5000
# HMAC key for gateway tokens, session tokens and Flask sessions
SECRET_KEY=change-me-in-production
